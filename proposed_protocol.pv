(* ProVerif model of the proposed hash-based protocol (single session, no key update).
   Run:  proverif proposed_protocol.pv
   A = H(k || NR || NT || 01)  is modelled by H1,  B = H(k || NT || NR || 02)  by H2.
   The adversary controls the channel c; the key k is a private name. *)

type key. type nonce.
fun H1(key,nonce,nonce): bitstring.
fun H2(key,nonce,nonce): bitstring.
free c: channel.
free k: key [private].

event TagSends(nonce,nonce).     event ServerAccepts(nonce,nonce).
event ServerSendsB(nonce,nonce). event TagAccepts(nonce,nonce).

(* Properties reported in the paper (Section 7.2) *)
query attacker(k).
query nr:nonce, nt:nonce;
  event(ServerAccepts(nr,nt)) ==> event(TagSends(nr,nt)).

(* Additional queries; add the results to the paper only if ProVerif returns "true":
query nr:nonce, nt:nonce;
  event(TagAccepts(nr,nt)) ==> event(ServerSendsB(nr,nt)).
query nr:nonce, nt:nonce;
  inj-event(ServerAccepts(nr,nt)) ==> inj-event(TagSends(nr,nt)).
*)

let Tag(k:key) =
  in(c, nr:nonce); new nt:nonce; event TagSends(nr,nt);
  out(c, (nt, H1(k,nr,nt))); in(c, b:bitstring);
  if b = H2(k,nt,nr) then event TagAccepts(nr,nt).

let Server(k:key) =
  new nr:nonce; out(c, nr); in(c, (nt:nonce, a:bitstring));
  if a = H1(k,nr,nt) then
  event ServerAccepts(nr,nt); event ServerSendsB(nr,nt); out(c, H2(k,nt,nr)).

process !Tag(k) | !Server(k)
